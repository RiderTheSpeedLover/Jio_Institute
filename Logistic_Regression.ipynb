        "import pandas as pd\n",
        "import statsmodels.api as sm\n",
        "from statsmodels.formula.api import ols\n",
        "\n",
        "# Load the dataset\n",
        "file_path = \"experiment data.xlsx\"  # Update with your actual file path\n",
        "data = pd.read_excel(file_path)\n",
        "\n",
        "# Rename the column to avoid spaces (optional but recommended)\n",
        "data.rename(columns={\"Purchase likelihood\": \"Purchase_likelihood\"}, inplace=True)\n",
        "\n",
        "# Perform 2x2 ANOVA\n",
        "# Updated formula to avoid backtick errors\n",
        "model = ols(\"Purchase_likelihood ~ C(Condition1) * C(Condition2)\", data=data).fit()\n",
        "anova_table = sm.stats.anova_lm(model, typ=2)\n",
        "\n",
        "# Print ANOVA table\n",
        "print(\"2x2 ANOVA Table:\")\n",
        "print(anova_table)\n"
