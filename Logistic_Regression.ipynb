      "source": [
        "import pandas as pd\n",
        "from scipy.stats import f_oneway\n",
        "\n",
        "# Load your dataset\n",
        "file_path = \"experiment data.xlsx\"  # Update with your actual file path\n",
        "data = pd.read_excel(file_path)\n",
        "\n",
        "# Check the data structure\n",
        "print(data.head())\n",
        "\n",
        "# Group data based on Condition1 or Condition2\n",
        "# Example: Comparing \"Purchase likelihood\" across different \"Condition1\" categories\n",
        "groups = [data[data[\"Condition1\"] == condition][\"Purchase likelihood\"] for condition in data[\"Condition1\"].unique()]\n",
        "\n",
        "# Perform ANOVA test\n",
        "anova_result = f_oneway(*groups)\n",
        "\n",
        "# Print the ANOVA results\n",
        "print(\"ANOVA Test Result:\")\n",
        "print(\"F-statistic:\", anova_result.statistic)\n",
        "print(\"p-value:\", anova_result.pvalue)\n"
      ],
